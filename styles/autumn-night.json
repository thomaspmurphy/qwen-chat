{
  "_comment": "glow/glamour style ported from bat/themes/autumn-night.tmTheme (itself the Abstract Machines terminal palette, rex/themes/Abstract Machines). Background stays the terminal's true black.",
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#e4e2cf", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#a89984", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#ffc107", "bold": true },
  "h1": { "prefix": "# ", "color": "#ffc107", "bold": true },
  "h2": { "prefix": "## ", "color": "#f05e48", "bold": true },
  "h3": { "prefix": "### ", "color": "#99be70", "bold": true },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "color": "#a89984" },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#626c66", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "#ffc107" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#626c66", "underline": true },
  "link_text": { "color": "#ffc107" },
  "image": { "color": "#626c66", "underline": true },
  "image_text": { "color": "#ffc107", "format": "Image: {{.text}} →" },
  "code": { "color": "#99be70" },
  "code_block": {
    "color": "#e4e2cf",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e4e2cf" },
      "error": { "color": "#e4e2cf", "background_color": "#f05e48" },
      "comment": { "color": "#626c66", "italic": true },
      "comment_preproc": { "color": "#626c66" },
      "keyword": { "color": "#f05e48" },
      "keyword_reserved": { "color": "#f05e48" },
      "keyword_namespace": { "color": "#f05e48" },
      "keyword_type": { "color": "#e4e2cf", "italic": true },
      "operator": { "color": "#e4e2cf" },
      "punctuation": { "color": "#e4e2cf" },
      "name": { "color": "#e4e2cf" },
      "name_builtin": { "color": "#ffc107" },
      "name_tag": { "color": "#f05e48" },
      "name_attribute": { "color": "#a89984" },
      "name_class": { "color": "#e4e2cf", "italic": true },
      "name_constant": { "color": "#ffc107" },
      "name_decorator": { "color": "#ffc107" },
      "name_exception": { "color": "#f05e48" },
      "name_function": { "color": "#ffc107" },
      "name_other": { "color": "#e4e2cf" },
      "literal": { "color": "#ffc107" },
      "literal_number": { "color": "#ffc107" },
      "literal_date": { "color": "#ffc107" },
      "literal_string": { "color": "#99be70" },
      "literal_string_escape": { "color": "#ffc107" },
      "generic_deleted": { "color": "#f05e48" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#99be70" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#a89984" },
      "background": { "background_color": "#000000" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
